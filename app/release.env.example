APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
APPLE_ID="you@example.com"
APPLE_PASSWORD="app-specific-password"
APPLE_TEAM_ID="TEAMID"
# Keep the original private key for all future releases.
TAURI_SIGNING_PRIVATE_KEY="$HOME/.config/aibo/updater.key"
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# Alternative to APPLE_ID + APPLE_PASSWORD: App Store Connect API credentials.
# The release script prefers this complete triplet when configured.
# APPLE_API_ISSUER="issuer-uuid"
# APPLE_API_KEY="KEY_ID"
# APPLE_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_KEY_ID.p8"
