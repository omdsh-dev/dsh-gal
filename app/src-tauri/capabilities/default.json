{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Loading page listens for supervisor status events; the UI drags and zooms the window from its top strip, and page zoom answers the usual hotkeys",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:webview:allow-set-webview-zoom"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:4877/*",
      "http://127.0.0.1:4878/*"
    ]
  }
}
