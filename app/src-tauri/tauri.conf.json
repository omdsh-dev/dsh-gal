{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aibo",
  "version": "0.1.0",
  "identifier": "dev.williamjin.aibo",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "bash scripts/stage-plugin.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Aibo",
        "width": 1280,
        "height": 760,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#04101c",
        "backgroundThrottling": "disabled",
        "zoomHotkeysEnabled": false
      },
      {
        "label": "launcher",
        "url": "launcher.html",
        "title": "Aibo",
        "width": 700,
        "height": 104,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../plugin/": "plugin/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/omdsh-dev/dsh-gal/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4MEVDMzcxQkIzRjRDMDUKUldRRlREKzdjY01PYUluandZMWVhMzdaODRTblBBeEpTWnFwT1RhNlF0TzQ0dXJKN3JxWVJYQlgK"
    }
  }
}
